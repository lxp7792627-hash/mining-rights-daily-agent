# Docker Compose reads .env. For local Node, export variables in your shell.
NEWS_FEEDS=https://www.mining.com/feed/,https://www.miningweekly.com/page/home/feed,https://www.mining-technology.com/feed/
# Authorized JSON data, not a scraped or invented LME quote.
LME_PRICE_FILE=/app/data/prices.json
# Alternative: public HTTPS endpoint returning the same JSON array.
LME_PRICE_URL=
# Optional exact hostname allowlist, comma separated. Include PDF/feed redirect hosts.
ALLOWED_HOSTS=
